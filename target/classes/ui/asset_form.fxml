<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.ui.controllers.AssetFormController"
      spacing="10"
      prefWidth="400"
      prefHeight="320">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>


    <Label text="Asset Details" />

    <GridPane hgap="10" vgap="10">
        <!-- Tag -->
        <Label text="Tag:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTag" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Name -->
        <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Location -->
        <Label text="Location:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLocation" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Qty -->
        <Label text="Qty:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtQty" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Status -->
        <Label text="Status:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbStatus" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Unit Cost -->
        <Label text="Unit Cost:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtUnitCost" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Acquired -->
        <Label text="Acquired:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <DatePicker fx:id="txtAcquired" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>


    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancel" onAction="#onCancel"/>
        <Button fx:id="btnSave" text="Save" onAction="#onSave"/>
    </HBox>
</VBox>
