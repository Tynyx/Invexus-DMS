<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.ui.controllers.MainController"
            stylesheets="@invexus.css">
    <top>
        <VBox spacing="8">
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Import CSV..." onAction="#onImportCSV"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#onExit"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About" onAction="#onAbout"/>
                </Menu>
            </MenuBar>

            <!-- banner -->
            <HBox spacing="16" styleClass="banner" alignment="CENTER_LEFT">
                <Label text="Invexus DMS" styleClass="title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Total Assets Value:" styleClass="metric-label"/>
                <Label fx:id="lblTotalValue" text=" '$0.00' " styleClass="metric-value"/>
            </HBox>

            <!-- filters / actions -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
                <padding>
                    <Insets topRightBottomLeft="10"/>
                </padding>
                <TextField fx:id="txtSearchTag" promptText="Search by tag..." onKeyReleased="#onFilterChanged"/>
                <ComboBox fx:id="cmbStatus" onAction="#onFilterChanged"/>
                <Button text="Add Asset" onAction="#onAddAsset"/>
                <Button text="Edit Selected" onAction="#onEditAsset"/>
                <Button text="Delete Selected" onAction="#onDeleteAsset"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblAssets">
            <columns>
                <TableColumn fx:id="colTag" text="Tag" prefWidth="100"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="100"/>
                <TableColumn fx:id="colLocation" text="Location" prefWidth="350"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                <TableColumn fx:id="colQty" text="Qty"/>
                <TableColumn fx:id="colUnitCost" text="Unit Cost" prefWidth="120"/>
                <TableColumn fx:id="colAcquired" text="Acquired" prefWidth="140"/>
                            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" styleClass="statusbar" alignment="CENTER_LEFT">
            <padding>
                <Insets topRightBottomLeft="8"/>
            </padding>
            <Label fx:id="lblStatus" text="Ready"/>
        </HBox>
    </bottom>
</BorderPane>
